# Copy this file to ".env" and fill it in. Never commit ".env".

# Steam Web API key: https://steamcommunity.com/dev/apikey  (domain: localhost)
STEAM_API_KEY=your_steam_api_key

# Same value as VITE_FIREBASE_DATABASE_URL in ../.env.local
FIREBASE_DATABASE_URL=https://your-database.REGION.firebasedatabase.app

# Service-account key downloaded from Firebase Console (see ../STEAM_SETUP.md)
GOOGLE_SERVICE_ACCOUNT_FILE=./serviceAccountKey.json

# Where the React app runs (Vite). Steam sends the user back here.
APP_URL=http://localhost:5173

PORT=3001
